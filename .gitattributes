# Scripts run on the Pi must stay LF — a CRLF shebang line fails with
# "bash\r: bad interpreter" — regardless of Windows autocrlf settings.
*.sh        text eol=lf
start_dev   text eol=lf
*.service   text eol=lf
*.rules     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Windows launchers keep CRLF.
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets.
*.ttf       binary
*.png       binary
*.sqlite    binary
