# Every text file is stored and checked out with LF line endings, on every
# OS. The Pi runs these scripts and units directly: a CRLF shebang fails with
# "env: 'bash\r': No such file or directory", and systemd rejects CR in units.
* text=auto eol=lf

# Windows launchers keep CRLF.
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binary assets.
*.ttf       binary
*.png       binary
*.ico       binary
*.sqlite    binary
*.dbc       text eol=lf
