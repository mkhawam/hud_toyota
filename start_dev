#!/usr/bin/env bash
# Dev launcher: backend (sim vehicle) + Vite dev server with hot reload.
#
#   ./start_dev            # sim data
#   ./start_dev elm327     # real adapter plugged into this machine
#
# First run bootstraps the venv and node_modules automatically.
# Frontend: http://localhost:5173/?mirror=0   (hot reload, proxies to backend)
set -euo pipefail
cd "$(dirname "$0")"

SOURCE="${1:-sim}"
PORT=8000  # vite.config.ts proxies /ws and /api to this port

# venv python — Windows (Scripts/) or POSIX (bin/) layout
if [ -x .venv/Scripts/python.exe ]; then
    PY=.venv/Scripts/python
elif [ -x .venv/bin/python ]; then
    PY=.venv/bin/python
else
    echo "==> first run: creating .venv and installing python deps"
    python -m venv .venv 2>/dev/null || python3 -m venv .venv
    if [ -x .venv/Scripts/python.exe ]; then PY=.venv/Scripts/python; else PY=.venv/bin/python; fi
    "$PY" -m pip install -q -e ".[dev]"
fi

if [ ! -d web/node_modules ]; then
    echo "==> first run: installing frontend deps"
    (cd web && npm install --no-fund --no-audit)
fi

echo "==> backend on :$PORT (vehicle source: $SOURCE)"
"$PY" -m hud --source "$SOURCE" --port "$PORT" &
BACKEND_PID=$!
trap 'kill "$BACKEND_PID" 2>/dev/null || true' EXIT INT TERM

echo "==> vite dev server — open http://localhost:5173/?mirror=0"
cd web && npm run dev
