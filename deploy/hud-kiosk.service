# Chromium fullscreen inside the cage Wayland compositor, straight on tty1.
# PAMName+TTY settings are the canonical cage kiosk pattern — no desktop,
# no login manager, ~10s to pixels.
[Unit]
Description=HUD kiosk (Chromium in cage)
After=hud-server.service systemd-user-sessions.service getty@tty1.service plymouth-quit-wait.service
Wants=hud-server.service
# Take tty1 away from the login prompt — otherwise both fight for the screen.
# (A desktop display manager would win the seat outright; install.sh switches
# desktop images to console boot for the same reason.)
Conflicts=getty@tty1.service

[Service]
User=__USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Restart=always
RestartSec=2
# Invisible cursor theme (deploy/xcursor_invisible.py): cage's default arrow
# would otherwise sit on the windshield until the first mouse move. The HUD
# page draws its own cursor while the mouse is actually moving.
Environment=XCURSOR_THEME=hud-invisible XCURSOR_SIZE=24
# Don't start the compositor before the panel has reported itself (cheap
# HDMI panels come up slower than the Pi); gives up after 30 s and tries anyway.
ExecStartPre=-/usr/bin/timeout 30 /bin/sh -c 'until grep -qs ^connected /sys/class/drm/card*-HDMI-A-*/status; do sleep 1; done'
ExecStart=/usr/bin/cage -- __HUD_DIR__/deploy/kiosk.sh

[Install]
WantedBy=multi-user.target
